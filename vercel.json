{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Skip build — CommonJS langsung siap jalan'",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "public/vcard-pdf.html"
    },
    "api/cetak.js": {
      "maxDuration": 300,
      "memory": 3008,
      "includeFiles": "public/vcard-pdf.html"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/kta/(.*)", "dest": "/api/index.js" },
    { "src": "/share-card/(.*)", "dest": "/api/index.js" },
    { "src": "/qrcode/(.*)", "dest": "/api/index.js" },
    { "src": "/uploads/(.*)", "dest": "/api/proxy.js" },
    { "src": "/(.*)", "dest": "/api/proxy.js" }
  ]
}
