[TEMPLATE]
# ============================================================
# SIKEDA — Environment variables untuk Render.com
# Diisi di: dashboard Render → Web Service sikeda → Environment
# (Render TIDAK memakai file .env — baris di bawah hanya panduan
#  nama kunci & format nilainya)
# ============================================================

# --- Wajib: database (MySQL Hostinger yang sudah ada) ---
# Nilai asli host/user/nama DB diisi langsung di dashboard Render
# (jangan pernah ditulis di repo — file ini hanya panduan nama kunci).
DB_HOST=HOST_MYSQL_ANDA
DB_PORT=3306
DB_USER=USER_DB_ANDA
DB_PASSWORD=PASSWORD_DB_ANDA
DB_NAME=NAMA_DB_ANDA

# --- Wajib: secret ---
# JWT_SECRET: buat acak baru → openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES=12h

# NIK_ENC_KEY: WAJIB sama persis dengan .env versi lama (dev/Hostinger)
# agar NIK anggota yang sudah terenkripsi tetap terbaca.
# Format: 64 karakter hex → openssl rand -hex 32
# JANGAN ganti setelah ada data anggota — NIK lama tak terbaca.
NIK_ENC_KEY=

# --- Wajib: URL publik ---
# Hasil akhir: https://sikeda.onrender.com (atau domain kustom Anda)
# Dipakai semua tautan keluar: QR kartu, lampiran PDF WA/Telegram, email
APP_URL=https://sikeda.onrender.com

# --- Persistent Disk (uploads foto/latar) ---
# Mount path disk yang dibuat render.yaml (atau manual di dashboard)
UPLOADS_DIR=/var/data/uploads

# --- Opsional ---
NODE_ENV=production
CORS_ORIGINS=

# Matikan endpoint login demo di produksi (disarankan)
DEMO_LOGIN=off

# --- Cetak PDF (puppeteer) ---
# Runtime Node native Render: unduhan Chromium jalan otomatis saat build
# (jangan set PUPPETEER_SKIP_DOWNLOAD). Bila pakai Dockerfile, unduhan
# di-skip dan memakai Chromium sistem:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
