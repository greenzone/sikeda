[TEMPLATE]
# ============================================================
# SIKEDA — Environment Variables untuk Vercel
# Isi di: Vercel Dashboard → Project → Settings → Environment Variables
# (Production + Preview). JANGAN commit file .env ke repo.
# ============================================================

# ---------- Database (MySQL remote — Hostinger) ----------
DB_HOST=HOST_MYSQL_ANDA
DB_PORT=3306
DB_USER=USER_DB_ANDA
DB_PASSWORD=PASSWORD_DB_ANDA
DB_NAME=NAMA_DB_ANDA

# ---------- Secret (WAJIB sama antar platform) ----------
# JWT_SECRET: token login. Buat acak: openssl rand -hex 32
JWT_SECRET=GANTI-DENGAN-STRING-ACAK-PANJANG
# NIK_ENC_KEY: HARUS SAMA PERSIS dengan .env versi Node/Render —
# kalau beda, NIK terenkripsi lama tidak bisa dibaca.
# Format: 64 karakter hex.
NIK_ENC_KEY=SALIN-DARI-ENV-LAMA-64-HEX

# ---------- App ----------
APP_URL=https://nama-project.vercel.app
# CORS_ORIGINS kosong = frontend & API satu origin (default Vercel).
CORS_ORIGINS=

# ---------- Gateway (opsional; bisa diisi lewat menu Pengaturan) ----------
FONNTE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---------- Catatan ----------
# UPLOADS_DIR tidak dipakai di Vercel (filesystem read-only kecuali /tmp).
# Foto & gambar kartu tersimpan di /tmp/sikeda-uploads (persist per
# instance, terisi ulang otomatis dari DB bila diperlukan) — untuk
# produksi jangka panjang pertimbangkan Vercel Blob.
